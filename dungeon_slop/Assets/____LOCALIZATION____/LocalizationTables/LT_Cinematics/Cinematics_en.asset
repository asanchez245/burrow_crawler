  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Cinematics_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 5b0e7a61a7fedc2498c0b7a9a4dd1da9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2418756421771264
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2418756480491520
    m_Localized: 'Instructions sent by the Brotherhood to the Rabbit:'
    m_Metadata:
      m_Items: []
  - m_Id: 2418756480491521
    m_Localized: <i>Rabbit, flesh of our flesh,</i>
    m_Metadata:
      m_Items: []
  - m_Id: 2418756480491522
    m_Localized: <i>I trust you are aware of the situation in the North.</i>
    m_Metadata:
      m_Items: []
  - m_Id: 2418756480491523
    m_Localized: <i>There is nothing left to save there; those lands have long since
      ceased to be fruitful to anyone.</i>
    m_Metadata:
      m_Items: []
  - m_Id: 2418756480491524
    m_Localized: <i>Now <shake>"That"</shake> is shaking the plateau, twisting beneath
      its depths.</i>
    m_Metadata:
      m_Items: []
  - m_Id: 2418756480491525
    m_Localized: <i>Travel east from the Warren; the abandoned well will be your
      way in.</i>
    m_Metadata:
      m_Items: []
  - m_Id: 2418756480491526
    m_Localized: <i>Go as deep as you can and report everything you discover to the
      Brotherhood.</i>
    m_Metadata:
      m_Items: []
  - m_Id: 2418756480491527
    m_Localized: <i>The Council will decide the fate of the plateau.</i>
    m_Metadata:
      m_Items: []
  - m_Id: 2418756480491528
    m_Localized: <i>Do your part, Rabbit, and do not let anything frighten you,</i>
    m_Metadata:
      m_Items: []
  - m_Id: 2418756480491529
    m_Localized: <i>for when all have fallen, the Hares will still be dancing.</i>
    m_Metadata:
      m_Items: []
  - m_Id: 2418756480491530
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2449864316248064
    m_Localized: You pick up an envelope with instructions from the Brotherhood off
      the ground.
    m_Metadata:
      m_Items: []
  - m_Id: 2449864316248065
    m_Localized: It is addressed to another hare, but you recognize its contents,
    m_Metadata:
      m_Items: []
  - m_Id: 2449864316248066
    m_Localized: they are the same instructions you received, letter for letter.
    m_Metadata:
      m_Items: []
  - m_Id: 2449864316248067
    m_Localized: 'On the back of the envelope, you make out several words written
      in blood:'
    m_Metadata:
      m_Items: []
  - m_Id: 2449864316248068
    m_Localized: ....Hidden.......
    m_Metadata:
      m_Items: []
  - m_Id: 2449864316248069
    m_Localized: ........the Brotherhood...
    m_Metadata:
      m_Items: []
  - m_Id: 2449864316248070
    m_Localized: .............
    m_Metadata:
      m_Items: []
  - m_Id: 2449864316248071
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2449864316248072
    m_Localized: <shake>"THAT"</shake>
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
